#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
stamps="$(cd "$(git rev-parse --git-common-dir)" && pwd)/winvm-verify"
runner="${WINVM_VERIFY_RUNNER:-$(git config --get winvm.verifyRunner || true)}"
runner="${runner:-local}"

while read -r _ local_sha _ _; do
  [[ $local_sha =~ ^0+$ ]] && continue
  tree="$(git rev-parse "${local_sha}^{tree}")"
  [ -f "$stamps/$tree.json" ] && continue
  echo "pre-push: no verify stamp for tree $tree, running the $runner runner on $local_sha" >&2
  if [ "$runner" = local ]; then
    if [ "$(git rev-parse HEAD)" != "$local_sha" ]; then
      echo "pre-push: the local runner verifies the checked-out commit; check out $local_sha or set winvm.verifyRunner" >&2
      exit 1
    fi
    bun scripts/verify.ts --runner local
  else
    "$runner" "$local_sha"
  fi
  if [ ! -f "$stamps/$tree.json" ]; then
    echo "pre-push: the $runner runner did not write $stamps/$tree.json" >&2
    exit 1
  fi
done
