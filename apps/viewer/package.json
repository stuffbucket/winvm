    "@types/react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@winvm/canvas": "workspace:*",
    "@winvm/terminal": "workspace:*",
    "intl-messageformat": "11.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.1.11"
  }
