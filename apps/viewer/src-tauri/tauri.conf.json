{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winvm",
  "mainBinaryName": "winvm-viewer",
  "version": "0.1.0",
  "identifier": "co.stuffbucket.winvm",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "winvm",
        "width": 1024,
        "height": 816,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTY3OTk4RTVBMTk2QkIKUldTN2xxSGxtSGtXNVBTVVBkdytKU1h4Y0V5allXZHVLazlQdnphbnBDRTROTHFrek5ZNzVTdXYK",
      "endpoints": [
        "https://github.com/stuffbucket/winvm/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/winvm"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
