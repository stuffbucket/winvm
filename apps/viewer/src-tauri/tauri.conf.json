{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winvm",
  "mainBinaryName": "winvm-viewer",
  "version": "0.1.0",
  "identifier": "co.stuffbucket.winvm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "winvm",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/winvm"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
