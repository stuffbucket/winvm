app_path = apps/viewer/src-tauri/target/release/bundle/macos/winvm.app
volname = winvm
bundle_id = co.stuffbucket.winvm
entitlements = default
# The update bundle is what the app's updater installs in place: a tarball of
# the notarized app and its signature (winvm's updater key, bound to the tag's
# version). scripts/release-assets.sh checks it and lists it in latest.json.
artifact = dmg,updater
updater_name = winvm-{tag}-darwin-arm64.app.tar.gz

# The builder signs every nested Mach-O after the producer exits: the compiled
# CLI (bun-runtime), the runtime's QEMU (qemu-hvf) and every other runtime
# binary and library (default). Generated by apps/viewer/scripts/sign-list.ts;
# build.sh fails if it no longer matches the built app.
sign_nested = Contents/MacOS/winvm:bun-runtime,Contents/Resources/runtime/bin/qemu-img:default,Contents/Resources/runtime/bin/qemu-system-aarch64:qemu-hvf,Contents/Resources/runtime/bin/swtpm:default,Contents/Resources/runtime/bin/zstd:default,Contents/Resources/runtime/lib/libcrypto.4.dylib:default,Contents/Resources/runtime/lib/libfdt.1.dylib:default,Contents/Resources/runtime/lib/libgcrypt.20.dylib:default,Contents/Resources/runtime/lib/libgio-2.0.0.dylib:default,Contents/Resources/runtime/lib/libglib-2.0.0.dylib:default,Contents/Resources/runtime/lib/libgmodule-2.0.0.dylib:default,Contents/Resources/runtime/lib/libgobject-2.0.0.dylib:default,Contents/Resources/runtime/lib/libgpg-error.0.dylib:default,Contents/Resources/runtime/lib/libintl.8.dylib:default,Contents/Resources/runtime/lib/libjson-glib-1.0.0.dylib:default,Contents/Resources/runtime/lib/liblz4.1.dylib:default,Contents/Resources/runtime/lib/liblzma.5.dylib:default,Contents/Resources/runtime/lib/libpcre2-8.0.dylib:default,Contents/Resources/runtime/lib/libpixman-1.0.dylib:default,Contents/Resources/runtime/lib/libpng16.16.dylib:default,Contents/Resources/runtime/lib/libslirp.0.dylib:default,Contents/Resources/runtime/lib/libswtpm_libtpms.0.dylib:default,Contents/Resources/runtime/lib/libtpms.0.dylib:default,Contents/Resources/runtime/lib/libzstd.1.dylib:default
