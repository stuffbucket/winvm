{
  "name": "winvm-workspace",
  "version": "0.1.4",
  "private": true,
  "description": "A scriptable Windows 11 ARM64 guest on plain QEMU + Hypervisor.framework (macOS, Apple Silicon)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "prepare": "sh scripts/install-hooks.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck test && bun test scripts",
    "winvm": "bun apps/cli/src/winvm.ts",
    "verify": "bun scripts/verify.ts",
    "verify:fast": "bun scripts/verify.ts --fast",
    "lint": "biome ci --error-on-warnings .",
    "lint:types": "oxlint --type-aware -f default",
    "comments": "bun scripts/check-comments.ts",
    "encoding": "bun scripts/check-text-encoding.ts",
    "boundaries": "turbo boundaries",
    "knip": "knip",
    "deps": "depcruise --config .dependency-cruiser.cjs apps packages scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.0",
    "@winvm/cli": "workspace:*",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.3.4",
  "pnpmTarballUrlPolicy": {
    "rules": [
      {
        "registry": "https://packagefeedproxy.microsoft.io/npm/",
        "includeTarballHostSuffixes": [
          "pkgs.visualstudio.com"
        ],
        "action": "omit"
      }
    ]
  }
}
