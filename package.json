{
  "name": "winvm-workspace",
  "version": "0.1.2",
  "private": true,
  "description": "A scriptable Windows 11 ARM64 guest on plain QEMU + Hypervisor.framework (macOS, Apple Silicon)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck test && bun test scripts",
    "winvm": "bun apps/cli/src/winvm.ts"
  },
  "devDependencies": {
    "@winvm/cli": "workspace:*",
    "turbo": "^2.11.4"
  },
  "packageManager": "pnpm@12.3.4",
  "pnpmTarballUrlPolicy": {
    "rules": [
      {
        "registry": "https://packagefeedproxy.microsoft.io/npm/",
        "includeTarballHostSuffixes": [
          "pkgs.visualstudio.com"
        ],
        "action": "omit"
      }
    ]
  }
}
